PORT=8080
BIND_ADDRESS=0.0.0.0
TZ=Asia/Singapore
# Set true only when accessing through an HTTPS reverse proxy.
COOKIE_SECURE=false

# Optional Telegram worker. Create a bot via @BotFather and a Stride API token in Settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Optional negative group/supergroup ID. The allowed user is still the only writer.
TELEGRAM_ALLOWED_GROUP_ID=
STRIDE_API_TOKEN=
COMPOSE_PROFILES=pose,telegram
# Enable profiles through the CLI, or set COMPOSE_PROFILES=pose,telegram after configuring the bot.
