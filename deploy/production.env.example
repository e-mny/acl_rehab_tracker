# Merge these settings into the server's existing .env. Preserve its credentials.
# Use the same project name shown by docker compose ls for the existing deployment.
COMPOSE_PROJECT_NAME=acl_rehab_tracker
# Lowercase GitHub owner/repository, without the -app/-telegram/-pose suffix.
IMAGE_REPOSITORY=ghcr.io/YOUR_GITHUB_OWNER/YOUR_REPOSITORY
IMAGE_TAG=latest

# Exact existing Docker volume names. Missing volumes cause deployment to fail.
STRIDE_DATA_VOLUME=acl_rehab_tracker_stride_data
TELEGRAM_DATA_VOLUME=acl_rehab_tracker_telegram_data

PORT=8080
BIND_ADDRESS=0.0.0.0
TZ=Asia/Singapore
COOKIE_SECURE=false
COMPOSE_PROFILES=pose,telegram

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_GROUP_ID=
STRIDE_API_TOKEN=
